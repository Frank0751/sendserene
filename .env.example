# Database URL (only needed if using Prisma/database features)
# For Vercel deployment, use a PostgreSQL connection string from your database provider
DATABASE_URL="file:./dev.db"

# Z-AI SDK (used by the jargon decoder API route at /api/decode)
# This key is provided by the Z.AI platform
# In production, replace with Anthropic Claude API key as per the project brief
ZAI_API_KEY=""

# NextAuth (if authentication is enabled in future)
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL=""

# Stripe (if billing is enabled in future)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
